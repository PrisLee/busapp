# Copy to .env and fill in, then: set -a; source .env; set +a; python3 serve.py
#
# Free key from https://datamall.lta.gov.sg (request API access, arrives by email).
# Without it the app runs on simulated buses and says so on every screen.
DATAMALL_API_KEY=

# Optional overrides
# BUSAPP_HOST=127.0.0.1
# BUSAPP_PORT=8080
# BUSAPP_POLL_INTERVAL=60
# Minutes allowed for the lift and getting out of the building. An assumption,
# not a measurement -- raise it if mornings feel rushed, set 0 for ground floor.
# BUSAPP_EXIT_BUFFER_MIN=5
# BUSAPP_RAW_RETENTION_DAYS=30
